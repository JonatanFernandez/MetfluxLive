# Only what the web app needs is published: index.html, docs.html, css/, js/, data/ and vendor/.

# Local preprocessing and tests: Python scripts, their virtual environments and caches,
# the Node test scripts and the package.json they need
tools/
package.json
node_modules/
__pycache__/
*.pyc
.venv*/

# source models (downloaded by hand, converted into data/<slug>/*.json)
Human-GEM-*.zip
Mouse-GEM-*.zip
Rat-GEM-*.zip
Zebrafish-GEM-*.zip
Fruitfly-GEM-*.zip
Worm-GEM-*.zip
yeast-GEM-*.zip
ecoli-src/

# contributions to upstream models (issue/PR drafts, patches, verification scripts); already under tools/, listed for clarity
tools/upstream/

# supplementary tables of papers read for reference, not redistributable (e.g. Jang et al. 2019, Cell Metab)
data/mmc*.pdf
data/mmc*.xlsx
